generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SEKRETARIS
  K_SDM
  K_KUL
  K_RDT
  K_TEKHUM
  ADMIN_PPID
  USER
}

model Jabatan {
  id        String   @id @default(uuid())
  nama      String   @unique
  kode      String? // Opsional jika diperlukan
  users     User[]
  createdAt DateTime @default(now())
}

// 2. Model Unit Kerja (Tabel Terpisah)
model UnitKerja {
  id   String  @id @default(uuid())
  nama String  @unique
  kode String?

  createdAt     DateTime       @default(now())
  strukturUnits StrukturUnit[]
}

model StrukturUnit {
  id          String    @id @default(uuid())
  unitKerjaId String
  unitKerja   UnitKerja @relation(fields: [unitKerjaId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id]) // Prisma sekarang akan cocok dengan relasi di atas
  posisi      Posisi
}

enum Posisi {
  KASUBAG
  STAFF
  SEKRETARIS
  KEPALA_DIVISI
}

enum JenisCuti {
  Tahunan
  Sakit
  AlasanPenting @map("Alasan Penting")
  CutiBesar     @map("Cuti Besar")
  Melahirkan
}

// 3. User sekarang terhubung dengan relasi ke Jabatan dan UnitKerja
model User {
  id           String    @id @default(uuid())
  username     String?   @unique
  name         String?
  nip          String?
  email        String?   @unique
  noHp         String?
  npwp         String?
  password     String
  status_mfa   Boolean   @default(false)
  security     String    @default("kpusekadau")
  status_login Boolean   @default(false)
  avatar       String?
  role         Role      @default(USER)
  token        String?   @db.MediumText
  mfa_secret   String?   @db.MediumText
  save_mfa     Boolean   @default(false)
  active       Boolean   @default(true)
  golonganId   String?
  golongan     Golongan? @relation(fields: [golonganId], references: [id])
  gaji         String?
  // Relasi
  jabatanId    String? // Foreign Key ke Jabatan
  jabatan      Jabatan?  @relation(fields: [jabatanId], references: [id])

  // unitKerjaId String? // Foreign Key ke UnitKerja
  // unitKerja   UnitKerja? @relation(fields: [unitKerjaId], references: [id])

  strukturUnit StrukturUnit[]

  Absens           Absen[]
  LaporanHarians   LaporanHarian[]
  ReportKesalahans ReportKesalahanData[]
  PengajuanCutis   PengajuanCuti[]
  SaldoCutis       SaldoCuti[]

  index     Int?
  secret    String?  @db.MediumText
  createdAt DateTime @default(now())
}

model ReportKesalahanData {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Field tambahan untuk kebutuhan laporan
  catatan   String   @db.Text
  status    String   @default("PENDING") // PENDING, PROCESSED, atau REJECTED
  createdAt DateTime @default(now())
}

model Golongan {
  id        String   @id @default(uuid())
  nama      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model Notifikasi {
  id        String   @id @default(uuid())
  message   String   @db.MediumText
  status    String   @default("unread")
  createdAt DateTime @default(now())
}

model LaporanHarian {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deskripsi String   @db.MediumText
  judul     String   @db.MediumText
  tanggal   DateTime
  createdAt DateTime @default(now())
}

enum StatusAbsen {
  hadir
  absen
  izin
  sakit
  cuti
  cuti_luar
  dinas_luar
  tugas_belajar
  tidak_hadir
}

model Absen {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status     StatusAbsen @default(tidak_hadir)
  jam_masuk  DateTime?
  jam_keluar DateTime?

  img_ttd    String  @db.MediumText
  keterangan String? @db.MediumText
  koordinat  String?

  createdAt DateTime @default(now())

  @@unique([userId, createdAt])
}

enum TahapPersetujuan {
  MENUNGGU_KASUBAG // Tahap 1: Menunggu dicek Kasubag
  MENUNGGU_SEKRETARIS // Tahap 2: Lolos dari Kasubag, menunggu Sekretaris
  DISETUJUI // Tahap Akhir: Sudah disetujui penuh
  DITOLAK_KASUBAG // Ditolak di tingkat Kasubag
  DITOLAK_SEKRETARIS // Ditolak di tingkat Sekretaris
  DIBATALKAN
}

model PengajuanCuti {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jenisCuti      JenisCuti
  tanggalMulai   DateTime  @db.Date
  tanggalSelesai DateTime  @db.Date
  totalHari      Int // Jumlah hari kerja murni (excl. Sabtu-Minggu)
  keterangan     String    @db.Text
  suratDokter    String?   @db.Text // URL berkas fisik surat sakit

  // Menggunakan Enum Alur Baru bertingkat untuk mengakomodasi aturan dinamis
  status TahapPersetujuan @default(MENUNGGU_KASUBAG)

  catatanAdmin String?  @db.Text // Alasan jika pengajuan ditolak
  createdAt    DateTime @default(now())

  @@index([userId])
}

// =================== MODEL BARU KONTROL SALDO KUOTA ===================
model SaldoCuti {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tahun             Int // Mengontrol jatah per tahun berjalan (Contoh: 2026)
  sisaTahunan       Int      @default(12) // Regulasi ASN: Default 12 hari kerja (Bisa akumulasi s/d 18)
  sisaSakit         Int      @default(14) // Batas pengajuan sakit reguler sebelum masuk jalur pemeriksaan intensif
  sisaAlasanPenting Int      @default(22) // Maksimal 1 bulan kerja (Rata-rata 22 hari kerja)
  sisaBesar         Int      @default(66) // Maksimal 3 bulan kerja (Rata-rata 66 hari kerja)
  sisaMelahirkan    Int      @default(90) // Hitungan hari kalender (3 bulan)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, tahun]) // Memastikan tidak ada duplikasi data kuota user di tahun yang sama
}
